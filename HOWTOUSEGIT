
# Instructions for fixing a small bug outside of the feature
# on the feature branch that you're working on

BUGFIXPREFIX='bugfix'
BUGFIXNAME='localunbounderror'


# Saving temporary work
git add .  && git commit -m "WIP"


# Creating a new feature branch for the bug
git switch main
git pull origin main
git switch -c "$BUGFIXPREFIX/$BUGFIXNAME"


# When bug is fixed, push to main
BUGFIXCOMMENT='Adding '
git commit -m "Fix: $BUGFIXCOMMENT"
git push -u origin "$BUGFIXPREFIX/$BUGFIXNAME"


# switching back to previous work
git switch main
git pull
git switch feature/azurefunction-processing
git merge main
