#####################
# General variables #
#####################
# ADX (Azure Data Explorer) - Target database where parsed artifacts are ingested.
ADX_CLUSTER_ENABLED=true
ADX_CLUSTER_URI=https://orangerose-adx01.westeurope.kusto.windows.net
ADX_CLUSTER_INGESTION_URI=https://ingest-orangerose-adx01.westeurope.kusto.windows.net
ADX_DATABASE_NAME=dfir

# Azure Table Storage - Used for writing status updates during processing.
BLOB_LOGTABLE_ENABLED=true
BLOB_LOGTABLE_URI=https://orangerosevelofiles.table.core.windows.net
BLOB_LOGTABLE_NAME=statusupdate

# Azure Queue Storage - Used by Azure Functions to trigger processing of triage packages.
BLOB_QUEUE_ENABLED=false
BLOB_QUEUE_URL=https://pearlfernstorageacount.queue.core.windows.net
BLOB_QUEUE_NAME=triagepackages

# Azure KeyVault - Used for securely retrieving secrets such as passwords and keys.
KEYVAULT_ENABLED=true
KEYVAULT_URL=https://orangerose-keyvault.vault.azure.net/
KEYVAULT_PASSWORDLOCATION=velo-password


##########################
# Velociraptor variables #
##########################
# Velociraptor is used for post-processing collected artifacts.
# The binary is downloaded at runtime from the URL below.
VELOCIRAPTOR_ENABLED=true # This enables or disables post-processing with Velociraptor
VELOCIRAPTOR_URL=https://github.com/Velocidex/velociraptor/releases/download/v0.74/velociraptor-v0.74.5-linux-amd64
VELOCIRAPTOR_BINARY=/tmp/velociraptor
VELOCIRAPTOR_REMAPPINGDIR=/tmp/velociraptor_remapping
VELOCIRAPTOR_DEFINITIONS=velociraptor/definitions/
VELOCIRAPTOR_OUTPUTFORMAT=jsonl #csv, json or jsonl
VELOCIRAPTOR_ARTIFACTSLIST=velociraptor/artifacts/velociraptor_artifacts.json
VELOCIRAPTOR_POSTPROCESS=essential # full, or essential
VELOCIRAPTOR_DURATION=400 # sets the duration in seconds on when it should interupt postprocessing of one artifact


#################
# INPUT sources #
#################
# Configure the source(s) where the triage ZIP files are stored.
# Enable only the source(s) you want to use, and leave the rest disabled.

# SFTP - Remote file server access via SSH
SFTP_ENABLED=false
SFTP_KEYVAULTSECRETNAME=sftp-key
SFTP_USERNAME=sftp_read
SFTP_URL=files.nerium.nl
SFTP_PORT=22

# Local folder - Read ZIP files directly from a local or mounted directory.
VAR_LOCALFOLDER_ENABLED=false
VAR_LOCALFOLDER_DIRECTORY=/home/user/github/testdata/

# SAS - Azure Blob Storage access via a Shared Access Signature (SAS) token.
BLOB_STORAGEACCOUNT_SAS_ENABLED=true
BLOB_STORAGEACCOUNT_SAS=https://orangerosevelofiles.blob.core.windows.net/uploads?sp=l&st=2026-04-17T08:28:17Z&se=2026-04-17T16:43:17Z&spr=https&sv=2025-11-05&sr=c&sig=2kSUC1LUYyGGvtifFb%2Brjoba78J7khFXO7F1At7iH3M%3D

# Blob - Azure Blob Storage access via storage account credentials or managed identity.
BLOB_STORAGEACCOUNT_ENABLED=false
BLOB_STORAGEACCOUNT_URI=https://orangerosevelofiles.blob.core.windows.net
BLOB_CONTAINER_INPUT=uploads


####################
# Script variables #
####################
VAR_LOCALDEVICE_CONCURRENCY=1 #nr of concurrent executions
vAR_DOWNLOAD_DIRECTORY=/tmp/downloads
VAR_UNZIP_DIRECTORY=/tmp/unzip/
VAR_SAMPLE_SIZE=1000
VAR_DF_CHUNKSIZE=100000
VAR_LOGLOCATION=/tmp/log
VAR_WEBHOOK_URL=
VAR_REMOVEZIP=false
VAR_ZIPFILE_PREFIX= 
VAR_ZIPFILE_SUFFIX=.zip
VAR_LOCATION_IGNORELIST=.ignorelist.json
VAR_RETRYFAILED=true
VAR_VERIFYUPLOADS=false
VAR_LOGLEVEL=INFO #DEBUG or INFO is recommended
VAR_DELETE_PROCESSEDZIPFILES=false
VAR_ARTIFACT_SUMMARY_FILENAME='_summary.txt'
VAR_MASTER_SUMMARY_FILENAME='master_summary.csv'
VAR_ADD_HOSTNAME=true 
