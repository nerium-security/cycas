-- Default hunts created on a new Velociraptor server by bootstrap.py.
--
-- Hunts are created paused: start them from the GUI once clients have
-- enrolled. bootstrap.py runs this file again only when its content
-- changes, so editing it on a re-run adds new hunts next to the old ones.
--
-- To use your own hunts instead, set VELOCIRAPTOR_SERVER_HUNTS_URL in .env
-- to the URL of a file like this one (e.g. a SAS URL to a central blob).

LET Expires <= now() + 604800  -- 7 days

SELECT hunt(
    description="HUN005 - Collect targeted Windows Security event log",
    artifacts="Windows.EventLogs.Evtx",
    spec=dict(`Windows.EventLogs.Evtx`=dict(
        EvtxGlob="%SystemRoot%\\System32\\winevt\\Logs\\Security.evtx")),
    pause=TRUE, expires=Expires)
FROM scope()

SELECT hunt(
    description="HUN004 - Processes",
    artifacts="Windows.System.Pslist",
    spec=dict(`Windows.System.Pslist`=dict(DISABLE_DANGEROUS_API_CALLS='Y')),
    pause=TRUE, expires=Expires)
FROM scope()

SELECT hunt(
    description="HUN003 - NetstatEnriched",
    artifacts="Windows.Network.NetstatEnriched",
    spec=dict(`Windows.Network.NetstatEnriched`=dict(ProcessNameRegex=".", DISABLE_DANGEROUS_API_CALLS='Y')),
    pause=TRUE, expires=Expires)
FROM scope()

SELECT hunt(
    description="HUN002 - Windows Services",
    artifacts="Windows.System.Services",
    spec=dict(`Windows.System.Services`=dict(Calculate_hashes='Y', CertificateInfo='Y')),
    pause=TRUE, expires=Expires)
FROM scope()

SELECT hunt(
    description="HUN001 - DNS cache",
    artifacts="Windows.System.DNSCache",
    pause=TRUE, expires=Expires)
FROM scope()