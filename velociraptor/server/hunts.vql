-- Default hunts created on a new Velociraptor server by bootstrap.py.
--
-- Hunts are created paused: start them from the GUI once clients have
-- enrolled. bootstrap.py runs this file again only when its content
-- changes, so editing it on a re-run adds new hunts next to the old ones.
--
-- To use your own hunts instead, set VELOCIRAPTOR_SERVER_HUNTS_URL in .env
-- to the URL of a file like this one (e.g. a SAS URL to a central blob).
--
-- bootstrap.py sets TriageSasURL (write-only SAS URL to the Cycas input
-- container) and TriageZipPassword (the ZIP password Cycas uses, from Key
-- Vault), so a hunt can upload collections straight to Cycas.
--
-- Hunts are listed newest first in the GUI, so they are created in reverse.

LET Expires <= now() + 604800  -- 7 days

-- Live data (HUNT001-HUNT006) has its own small hunts: it is volatile, so
-- it should be collected first and not depend on the long triage collection.
-- Server.Utils.BackupAzure sends each finished flow to Cycas, so these results
-- end up in ADX as well. No hunt uploads executables, and potentially unstable
-- Windows APIs are disabled (DISABLE_DANGEROUS_API_CALLS) where an artifact
-- offers that.

-- Sigma detection: runs the Hayabusa ruleset (Velociraptor Sigma Project,
-- https://sigma.velocidex.com/, imported by bootstrap.py) against the event
-- logs on each endpoint, so only rule matches leave the endpoint. Critical,
-- high and medium rules that are stable or experimental; the noisy rules stay
-- excluded (the artifact's RuleExclusions default). Scanning all logs can take
-- longer than the default 10 minutes, hence the 1 hour timeout.
SELECT hunt(
    description="HUNT008 - Sigma detection with the Hayabusa rules",
    artifacts="Windows.Hayabusa.Rules",
    spec=dict(`Windows.Hayabusa.Rules`=dict(
        RuleLevel="Critical, High, and Medium",
        RuleStatus="Stable and Experimental")),
    timeout=3600,
    pause=TRUE, expires=Expires)
FROM scope()

-- Mass triage collection: each endpoint collects _KapeTriage, zips it and
-- uploads it straight to the Cycas input container, bypassing the server
-- (see the "Collecting triage packages at scale" guide). Review the targets
-- before starting it.
SELECT hunt(
    description="HUNT007 - Mass triage collection to Cycas (direct upload)",
    artifacts="Custom.Windows.Triage.Targets.AzureUpload",
    spec=dict(`Custom.Windows.Triage.Targets.AzureUpload`=dict(
        SasURL=TriageSasURL,
        ZipPassword=TriageZipPassword,
        -- Not _Live: it only adds the adaptive targets, which collect the
        -- executables behind processes, connections, services and tasks.
        HighLevelTargets='["_KapeTriage"]',
        -- The live data comes from the separate hunts, so not twice in ADX.
        CollectLiveData='N')),
    pause=TRUE, expires=Expires)
FROM scope()

SELECT hunt(
    description="HUNT006 - Scheduled tasks",
    artifacts="Windows.System.TaskScheduler",
    spec=dict(`Windows.System.TaskScheduler`=dict(AlsoUpload='N', UploadCommands='N')),
    pause=TRUE, expires=Expires)
FROM scope()


SELECT hunt(
    description="HUNT005 - Collect targeted Windows Security event log",
    artifacts="Windows.EventLogs.Evtx",
    spec=dict(`Windows.EventLogs.Evtx`=dict(
        EvtxGlob="%SystemRoot%\\System32\\winevt\\Logs\\Security.evtx")),
    pause=TRUE, expires=Expires)
FROM scope()

SELECT hunt(
    description="HUNT004 - Processes",
    artifacts="Windows.System.Pslist",
    spec=dict(`Windows.System.Pslist`=dict(DISABLE_DANGEROUS_API_CALLS='Y')),
    pause=TRUE, expires=Expires)
FROM scope()

SELECT hunt(
    description="HUNT003 - NetstatEnriched",
    artifacts="Windows.Network.NetstatEnriched",
    spec=dict(`Windows.Network.NetstatEnriched`=dict(
        ProcessNameRegex=".", DumpProcess='N', KillProcess='N', DISABLE_DANGEROUS_API_CALLS='Y')),
    pause=TRUE, expires=Expires)
FROM scope()

SELECT hunt(
    description="HUNT002 - Windows Services",
    artifacts="Windows.System.Services",
    spec=dict(`Windows.System.Services`=dict(
        Calculate_hashes='Y', CertificateInfo='Y', DISABLE_DANGEROUS_API_CALLS='Y')),
    pause=TRUE, expires=Expires)
FROM scope()

SELECT hunt(
    description="HUNT001 - DNS cache",
    artifacts="Windows.System.DNSCache",
    pause=TRUE, expires=Expires)
FROM scope()